  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MouseTask
  title: Catch the clockwork mouse
  introLine: Oh dear, the noise woke the clockwork mouse! Catch him before he hides
    under the armchair!
  hint: He runs off when you get close, but he stops to sniff every now and then.
    Grab him with the grip button, close up or from a distance with the ray.
  howItWorks: A small spring drives the mouse's wheels through gears. One wheel is
    set at a slight angle, so instead of going straight he scurries about in curves.
  clockTime: 23.75
  beaconTarget: {fileID: 1456540961}
  agent: {fileID: 1456540967}
  animator: {fileID: 1784383159}
  grab: {fileID: 1456540965}
  home: {fileID: 665868850}
  wanderRadius: 1.6
  fleeDistance: 1
  sniffSeconds: {x: 1.2, y: 2.2}
