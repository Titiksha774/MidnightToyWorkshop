  m_Script: {fileID: 11500000, guid: b9dca9f1ae797ee46bbc69da450edb4a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MusicBoxTask
  title: Mend the music box
  introLine: The music box on the mantelpiece has lost its crank. I left it on the
    workbench. Can you take it over?
  hint: The little brass crank is lying on the front of the workbench. Take it to
    the music box on the mantelpiece, fit it into the side of the box, then circle
    your hand three times to wind it.
  howItWorks: Turning the crank winds a spring that slowly spins a brass drum. Tiny
    pins on the drum pluck the steel teeth of a comb, and each tooth rings at its
    own note, so the pins play the tune.
  clockTime: 23.4
  beaconTarget: {fileID: 306159182}
  windsNeeded: 3
  windTarget: {fileID: 482531601}
  windRange: 1.8
  crank: {fileID: 306159184}
  crankSocket: {fileID: 1399479699}
  animator: {fileID: 80709943}
  tune: {fileID: 482531603}
