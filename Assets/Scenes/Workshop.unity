  m_Script: {fileID: 11500000, guid: a0dc86d37191b5f448473b3e36b37efe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JackInTheBoxTask
  title: Fix the jack-in-the-box
  introLine: Oh dear, the jack-in-the-box has lost his hat, his lid and his crank!
    They're scattered round the workshop. Follow the star.
  hint: His jester hat is on the armchair, the crank is on the corner of the toy-town
    table and the lid is on the fireplace hearth. Fit them onto the jack-in-the-box
    on the shelf, then circle your hand three times to wind it.
  howItWorks: The crank turns a little music wheel. When the tune reaches its end,
    a cam lifts the catch on the lid, and the squashed spring pushes the jester up
    and out.
  clockTime: 23.6
  beaconTarget: {fileID: 625512564}
  windsNeeded: 3
